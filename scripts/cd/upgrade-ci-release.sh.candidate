#!/usr/bin/env bash
set -euo pipefail
set +x
cd /opt/compose/yazio-dashboard
commit=${1:?exact commit required}
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || exit 2
image="nutrition-release:${commit:0:12}"
[[ "$(docker image inspect "$image" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')" == "$commit" ]] || exit 3
stamp=${CD_BACKUP_STAMP:?fixed backup stamp required}
[[ "$stamp" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+$ ]] || exit 2
compose() { docker compose --project-name nutrition --env-file runtime.env -f compose.yaml -f compose.home.yaml "$@"; }
container=$(compose ps -q app)
previous_image=$(docker inspect "$container" --format '{{.Config.Image}}')
previous_revision=$(docker inspect "$container" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')
[[ "$previous_image" =~ ^nutrition-release:[0-9a-f]{12}$ && "$previous_revision" =~ ^[0-9a-f]{40}$ ]] || exit 3
env_backup="runtime.env.pre-upgrade-$stamp"
cp -p runtime.env "$env_backup"
chmod 600 "$env_backup"
backup_ready=false
recovery_armed=false
snapshot() {
 compose run --rm --no-deps -e BACKUP_PREFIX="$1" --entrypoint node app -e '
 const fs=require("node:fs"),cp=require("node:child_process"),D=require("better-sqlite3");
 const prefix="/app/data/"+process.env.BACKUP_PREFIX;
 process.umask(0o077);
 function run(args){const r=cp.spawnSync(args[0],args.slice(1),{stdio:"inherit"});if(r.status!==0)process.exit(1);}
 run(["node","scripts/backup.mjs",prefix+".sqlite"]);
 const db=new D(prefix+".sqlite",{readonly:true});if(db.pragma("integrity_check",{simple:true})!=="ok")process.exit(1);db.close();
 run(["tar","-czf",prefix+"-uploads.tar.gz","-C","/app/uploads","."]);
 run(["gzip","-t",prefix+"-uploads.tar.gz"]);
 for(const [name,file] of [["yazio","yazio-token.json"],["transformmate","transformmate-token.json"]]){const original="/app/data/"+file;if(fs.existsSync(original)){fs.copyFileSync(original,prefix+"-"+name+"-connection.enc");fs.chmodSync(prefix+"-"+name+"-connection.enc",0o600);}else fs.writeFileSync(prefix+"-"+name+"-connection.absent","");}
 '
}
restore_snapshot() {
 compose run --rm --no-deps -e BACKUP_PREFIX="pre-upgrade-$stamp" --entrypoint node app -e '
 const fs=require("node:fs"),cp=require("node:child_process"),D=require("better-sqlite3");const prefix="/app/data/"+process.env.BACKUP_PREFIX;process.umask(0o077);
 for(const suffix of ["-wal","-shm"])fs.rmSync("/app/data/nutrition.sqlite"+suffix,{force:true});
 fs.copyFileSync(prefix+".sqlite","/app/data/nutrition.sqlite");const db=new D("/app/data/nutrition.sqlite");if(db.pragma("integrity_check",{simple:true})!=="ok")process.exit(1);db.close();
 for(const [name,file] of [["yazio","yazio-token.json"],["transformmate","transformmate-token.json"]]){const backup=prefix+"-"+name+"-connection.enc";if(fs.existsSync(backup)){fs.copyFileSync(backup,"/app/data/"+file);fs.chmodSync("/app/data/"+file,0o600);}else if(fs.existsSync(prefix+"-"+name+"-connection.absent"))fs.rmSync("/app/data/"+file,{force:true});else process.exit(1);}
 function run(args){const r=cp.spawnSync(args[0],args.slice(1),{stdio:"inherit"});if(r.status!==0)process.exit(1);}
 run(["find","/app/uploads","-mindepth","1","-maxdepth","1","-exec","rm","-rf","--","{}","+"]);
 run(["tar","-xzf",prefix+"-uploads.tar.gz","-C","/app/uploads"]);
 '
}
wait_healthy() {
 local expected_image=$1 expected_revision=$2 current
 for attempt in $(seq 1 30); do
  current=$(compose ps -q app) || return 1
  if [[ "$(docker inspect "$current" --format '{{.State.Health.Status}}')" == healthy && "$(docker inspect "$current" --format '{{.Config.Image}}')" == "$expected_image" && "$(docker inspect "$current" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')" == "$expected_revision" ]] && [[ "$(curl --silent --show-error --max-time 8 --output /dev/null --write-out '%{http_code}' https://nutrition.dimensi.dev/api/health)" == 200 ]]; then return 0; fi
  sleep 2
 done
 return 1
}
rollback() {
 compose stop app || return 1
 cp -p runtime.env "runtime.env.failed-before-rollback-$stamp" || return 1
 chmod 600 "runtime.env.failed-before-rollback-$stamp" || return 1
 cp -p "$env_backup" runtime.env || return 1
 if [[ "$backup_ready" == true ]]; then
  # Preserve failed-release writes before any destructive data restoration.
  snapshot "failed-before-rollback-$stamp" || return 1
  restore_snapshot || return 1
 fi
 compose up -d --no-build || return 1
 wait_healthy "$previous_image" "$previous_revision" || return 1
 echo "Previous exact image and healthy matching backup restored: $stamp"
}
recover_on_exit() {
 local status=$?
 trap - EXIT
 if [[ "$recovery_armed" == true ]]; then
  if rollback; then
   echo 'Deployment failed; previous exact healthy release restored.' >&2
  else
   echo 'ATTENTION: deployment and rollback failed; protected backups/failed state retained; operator action required.' >&2
  fi
  [[ "$status" != 0 ]] || status=1
 fi
 exit "$status"
}
trap recover_on_exit EXIT
recovery_armed=true
compose stop app
snapshot "pre-upgrade-$stamp"
backup_ready=true
python3 - "$commit" "$image" <<'PYENV'
from pathlib import Path
import sys
p=Path('runtime.env');lines=p.read_text().splitlines()
updates={'DEPLOYED_COMMIT':sys.argv[1],'NUTRITION_IMAGE':sys.argv[2]}
assert all(sum(line.startswith(key+'=') for line in lines)==1 for key in updates)
p.write_text('\n'.join(key+'='+updates[key] if (key:=line.split('=',1)[0]) in updates else line for line in lines)+'\n');p.chmod(0o600)
PYENV
compose config --quiet
compose up -d --no-build
compose exec -T app chmod 700 /app/data
wait_healthy "$image" "$commit"
recovery_armed=false
echo "Release started: $commit; consistent backups: pre-upgrade-$stamp"

DATABASE_URL=file:./.data/development.sqlite
BETTER_AUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=
DEMO_MODE=false
# Optional server-only encrypted token path, outside public/. Never NEXT_PUBLIC_*.
YAZIO_TOKEN_FILE=
# Hourly server synchronization. Enable only with a configured encrypted token store.
ENABLE_NUTRITION_SCHEDULER=false
UPLOADS_DIR=./.data/uploads
# Dashboard connection is entered by the owner in Settings; this path contains encrypted data.
TRANSFORMMATE_TOKEN_FILE=./.data/private/transformmate-token.json
# CLI probes only: the dashboard runtime does not use these credentials or an env fallback.
TRANSFORMMATE_FIREBASE_API_KEY=
TRANSFORMMATE_FIREBASE_REFRESH_TOKEN=

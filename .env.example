DATABASE_URL=file:./.data/development.sqlite
BETTER_AUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=
DEMO_MODE=false
# Optional server-only encrypted token path, outside public/. Never NEXT_PUBLIC_*.
YAZIO_TOKEN_FILE=
# Hourly server synchronization. Enable only with a configured encrypted token store.
ENABLE_NUTRITION_SCHEDULER=false
UPLOADS_DIR=./.data/uploads
# Dashboard connection is entered by the owner in Settings; this path contains encrypted data.
TRANSFORMMATE_TOKEN_FILE=./.data/private/transformmate-token.json
# CLI probes only: the dashboard runtime does not use these credentials or an env fallback.
TRANSFORMMATE_FIREBASE_API_KEY=
TRANSFORMMATE_FIREBASE_REFRESH_TOKEN=
# Общее объектное хранилище (SeaweedFS на NAS). Без S3_ENDPOINT файлы
# анамнеза хранятся локально в UPLOADS_DIR/object-storage (разработка и E2E).
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=apps
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Провайдер распознавания лабораторных PDF (OpenRouter API).
ANAMNESIS_LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
ANAMNESIS_LLM_MODEL=google/gemini-2.5-flash-lite
ANAMNESIS_LLM_TIMEOUT_MS=120000
# Периодический проход очереди импорта в продакшене; после загрузки обработка стартует всегда.
ENABLE_ANAMNESIS_WORKER=false

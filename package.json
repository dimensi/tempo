{
  "name": "yazio-dashboard",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "dev": "pnpm offline:build && NODE_ENV=development serwist build serwist.config.mjs && next dev",
    "offline:build": "node scripts/build-offline.mjs",
    "build": "pnpm offline:build && next build && serwist build serwist.config.mjs && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint . && tsx scripts/check-boundaries.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "tsx scripts/backup.ts",
    "auth:create-user": "tsx scripts/create-user.ts",
    "transformmate:probe": "node --conditions=react-server --import tsx scripts/transformmate-probe.ts",
    "transformmate:auth-probe": "node --conditions=react-server --import tsx scripts/transformmate-auth-probe.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:ci:selection": "node --test tests/ci/*.test.mjs",
    "test:ci:browsers": "node scripts/ci/browser-gates.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@serwist/cli": "9.5.13",
    "@serwist/next": "9.5.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/video.js": "7.3.58",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "serwist": "9.5.13",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@dimensi/yazio": "file:vendor/yazio",
    "@mantine/charts": "9.7.2",
    "@mantine/core": "9.7.2",
    "@mantine/dates": "9.7.2",
    "@mantine/form": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@mantine/notifications": "9.7.2",
    "@mantine/schedule": "9.7.2",
    "@playwright/test": "1.64.0",
    "@tabler/icons-react": "^3.49.0",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.23",
    "decimal.js": "10.6.0",
    "drizzle-orm": "^0.45.4",
    "jpeg-js": "0.4.4",
    "mediabunny": "1.61.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3",
    "server-only": "^0.0.1",
    "unpdf": "1.8.1",
    "video.js": "8.24.1",
    "zod": "^4.6.6"
  },
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.18 <23"
  },
  "type": "module"
}
